# Use official Node image
FROM node:20-alpine

# Set working directory
WORKDIR /app/ui

# Copy only dependency files first for caching
COPY ui/package*.json ./

# Install dependencies (using legacy flag to avoid React 19 peer issues)
RUN npm install --legacy-peer-deps

# Copy the rest of the UI source code
COPY ui/ ./

# Build the Next.js app (standalone for production)
RUN npm run build

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Expose port
EXPOSE 3000

# Start Next.js (no `server.js` needed)
# use npx so the installed next binary is invoked reliably
CMD ["npx", "next", "start", "-p", "3000"]
