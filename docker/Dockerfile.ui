# official Node.js image
FROM node:20-alpine

# Set working directory to the ui folder
WORKDIR /app/ui

# Copy package files from the ui folder only (use package-lock if present)
COPY ui/package*.json ./

# Install dependencies
RUN npm  --legacy-peer-deps --silent

# Copy only ui sources into the working dir
COPY ui/ ./

# Build the app
RUN npm run build

# Runtime environment
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# Start the application (adjust if your start file/path differs)
CMD ["node", "server.js"]
